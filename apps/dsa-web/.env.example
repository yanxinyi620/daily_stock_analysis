# Default local mode continues using the existing FastAPI backend.
VITE_DATA_BACKEND=local
# For development against a dedicated test Supabase project, use supabase above.
# npm run build:cloud always selects cloud mode and outputs dist/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CLOUD_REPORT_PAGE_SIZE=20
VITE_CLOUD_TIME_ZONE=Asia/Shanghai
# Never put Secret Key, service_role JWT, GitHub token, or model keys in VITE_*.
# Configure a separate test project for Preview/Development; never inherit Production credentials.
